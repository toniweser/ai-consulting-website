---
// Hero visual: one agent session from ticket to human approval, the workflow the workshop teaches.
// Durations add up to the total. Items reveal in sequence (see [data-reveal] in global.css).
const steps = [
  { text: 'Ticket gelesen', duration: '0:12' },
  { text: 'Test geschrieben, Fix umgesetzt', duration: '1:05' },
  { text: 'Doku aktualisiert, PR #318 erstellt', duration: '0:48' },
  { text: 'Agent-Review: Architektur und Konventionen', duration: '1:05' },
];
---

<figure class="overflow-hidden rounded-2xl border border-divider bg-card shadow-[0_24px_48px_rgba(31,27,22,0.08),0_2px_4px_rgba(31,27,22,0.04)]" data-reveal-group>
  <figcaption class="sr-only">Beispiel: Ein Coding Agent bearbeitet ein Ticket in 3 Minuten 10 Sekunden für 1,84 Euro, die Freigabe gibt ein Mensch.</figcaption>
  <div class="flex h-11 items-center gap-3 border-b border-divider px-4 font-mono text-xs text-muted">
    <span class="flex gap-1.5" aria-hidden="true">
      <i class="size-2.5 rounded-full bg-raised"></i><i class="size-2.5 rounded-full bg-raised"></i><i class="size-2.5 rounded-full bg-raised"></i>
    </span>
    agent · shop-backend
  </div>
  <div class="p-5 sm:p-6">
    <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-divider pb-4">
      <p class="text-[15px] font-medium text-heading">SHOP-412 · Versandkosten werden falsch gerundet</p>
      <span class="shrink-0 font-mono text-xs text-muted">Linear</span>
    </div>
    <ol class="grid gap-3 py-5 font-mono text-[13px] leading-5 text-body">
      {steps.map((step, index) => (
        <li class="grid grid-cols-[20px_1fr_auto] gap-2" data-reveal style={`--i: ${index + 1}`}>
          <span class="text-positive" aria-hidden="true">✓</span>
          <span>{step.text}</span>
          <span class="tabular-nums text-muted">{step.duration}</span>
        </li>
      ))}
    </ol>
    <div class="flex items-baseline justify-between gap-4 border-t border-dashed border-divider pt-4 font-mono text-[13px]" data-reveal style="--i: 5">
      <span class="text-muted">Gesamt</span>
      <span class="tabular-nums text-heading">3:10 min · 1,84 €</span>
    </div>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-2 rounded-[10px] bg-ink py-2 pl-3 pr-2 text-sm text-on-ink" data-reveal style="--i: 7">
      <span class="flex items-center gap-2 whitespace-nowrap">
        <span class="grid size-7 place-items-center rounded-full bg-on-ink/15 font-mono text-[11px]" aria-hidden="true">AK</span>
        Review von Anna<span class="hidden sm:inline">&nbsp;(Senior)</span>
      </span>
      <span class="whitespace-nowrap rounded bg-accent px-2.5 py-1.5 font-mono text-xs font-medium text-on-accent">Freigabe durch Mensch</span>
    </div>
  </div>
</figure>
