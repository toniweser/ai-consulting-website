---
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/global.css'
import { formats, MAX_PARTICIPANTS } from '../data/pricing';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const { title, description = "KI-Workshops für Entwicklungsteams — Christian Braun & Tobias Weber", ogImage, noindex = false } = Astro.props;
---

<html lang="de">
  <head>
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('motion');
        }
      })();
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" id="meta-theme" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Braun & Weber KI-Beratung" />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      "name": "Braun & Weber KI-Beratung",
      "url": "https://ki-workshop-unternehmen.de",
      "description": "KI-Workshops für Entwicklungsteams — hands-on, an Ihrem Code, mit Coding Agents.",
      "address": [
        { "@type": "PostalAddress", "addressLocality": "Fürth", "addressRegion": "Bayern", "addressCountry": "DE" }
      ],
      "founder": [
        { "@type": "Person", "name": "Tobias Weber", "jobTitle": "IT-Consultant & KI-Trainer" },
        { "@type": "Person", "name": "Christian Braun", "jobTitle": "IT-Consultant & KI-Trainer" }
      ],
      "knowsAbout": ["Künstliche Intelligenz", "Coding Agents", "Software-Entwicklung", "KI-Workshops"],
      "areaServed": { "@type": "Country", "name": "DE" },
      "telephone": "+4915256719943",
      "email": "hello@tobi-weber.com",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "KI-Workshops für Entwicklungsteams",
        "itemListElement": formats.map((f) => ({
          "@type": "Offer",
          "name": `KI-Workshop ${f.mode}, ${f.duration}`,
          "price": f.price,
          "priceCurrency": "EUR",
          "itemOffered": { "@type": "Service", "name": `KI-Workshop für Entwicklungsteams, ${f.mode}, ${f.duration}` },
          "description": `${f.items.filter((i) => i.included).map((i) => i.text).join(', ')}. Bis ${MAX_PARTICIPANTS} Teilnehmende.`,
          "priceSpecification": {
            "@type": "PriceSpecification",
            "price": f.price,
            "priceCurrency": "EUR",
            "valueAddedTaxIncluded": false
          }
        }))
      }
    })} />

    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />

    <script is:inline>
      // Reveal [data-reveal-group] blocks once they scroll into view (see global.css)
      (function() {
        var groups = document.querySelectorAll('[data-reveal-group]');
        var show = function(el) { el.classList.add('is-visible'); };
        if (!document.documentElement.classList.contains('motion') || !('IntersectionObserver' in window)) {
          groups.forEach(show);
          return;
        }
        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              show(entry.target);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.3 });
        groups.forEach(function(el) { observer.observe(el); });
      })();
    </script>

    <script is:inline>
      // Theme toggle
      (function() {
        var toggle = document.getElementById('theme-toggle');
        if (!toggle) return;

        function update() {
          var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          var sun = document.getElementById('icon-sun');
          var moon = document.getElementById('icon-moon');
          if (sun) sun.style.display = isDark ? 'block' : 'none';
          if (moon) moon.style.display = isDark ? 'none' : 'block';
          document.querySelectorAll('meta[name="theme-color"]').forEach(function(m) {
            m.content = isDark ? '#161513' : '#f7f4ee';
          });
        }

        toggle.addEventListener('click', function() {
          var cur = document.documentElement.getAttribute('data-theme');
          var next = cur === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          localStorage.setItem('theme', next);
          update();
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
          if (!localStorage.getItem('theme')) {
            var theme = e.matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', theme);
            update();
          }
        });

        update();
      })();
    </script>
  </body>
</html>
