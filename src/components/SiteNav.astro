---
interface Props {
  /** Show the section links and the CTA (landing page only) */
  sections?: boolean;
}
const { sections = false } = Astro.props;
const home = import.meta.env.BASE_URL;
const links = [
  { href: '#workshop', label: 'Workshop' },
  { href: '#fuer-wen', label: 'Für wen' },
  { href: '#preise', label: 'Preise' },
  { href: '#ueber-uns', label: 'Über uns' },
];
---

<nav class="fixed inset-x-0 top-0 z-50 border-b border-divider bg-surface-nav backdrop-blur-md">
  <div class="page flex h-16 items-center justify-between">
    <a href={home} class="text-[17px] font-medium text-heading">
      Braun &amp; Weber <span class="font-normal text-muted">KI-Workshops</span>
    </a>
    <div class="flex items-center gap-2">
      {sections && (
        <div class="hidden items-center gap-8 md:flex">
          {links.map((link) => (
            <a href={link.href} class="text-sm text-body transition-colors duration-150 hover:text-heading">{link.label}</a>
          ))}
          <a href="#kontakt" class="inline-flex h-9 items-center rounded-lg bg-ink px-4 text-sm font-medium text-on-ink transition-[background-color,transform] duration-150 hover:bg-ink-hover active:scale-[0.98]">Erstgespräch</a>
        </div>
      )}
      <button id="theme-toggle" class="ml-2 grid size-9 place-items-center rounded-lg text-body transition-colors duration-150 hover:bg-raised hover:text-heading" aria-label="Farbschema wechseln">
        <svg id="icon-sun" class="size-[18px]" style="display:none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
        </svg>
        <svg id="icon-moon" class="size-[18px]" style="display:none" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
        </svg>
      </button>
      {sections && (
        <button id="menu-toggle" class="-mr-2 grid size-9 place-items-center rounded-lg text-heading md:hidden" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      )}
    </div>
  </div>
  {sections && (
    <div id="mobile-menu" class="hidden border-t border-divider md:hidden">
      <div class="page flex flex-col gap-1 py-4">
        {links.map((link) => (
          <a href={link.href} class="mobile-nav-link flex h-10 items-center text-body transition-colors duration-150 hover:text-heading">{link.label}</a>
        ))}
        <a href="#kontakt" class="mobile-nav-link mt-2 inline-flex h-11 items-center justify-center rounded-[10px] bg-ink font-medium text-on-ink">Kostenloses Erstgespräch</a>
      </div>
    </div>
  )}
</nav>

{sections && (
  <script>
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const setOpen = (open: boolean) => {
      menu?.classList.toggle('hidden', !open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');
    };
    toggle?.addEventListener('click', () => setOpen(menu?.classList.contains('hidden') ?? false));
    document.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  </script>
)}
