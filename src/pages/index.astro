---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AgentSession from '../components/AgentSession.astro';
import ReviewCheck from '../components/ReviewCheck.astro';
import PromptEasterEgg from '../components/PromptEasterEgg.astro';
import LinkedInIcon from '../components/LinkedInIcon.astro';
import { formats, formatEuro, MAX_PARTICIPANTS } from '../data/pricing';

const base = import.meta.env.BASE_URL;

const outcomes = [
  {
    title: 'Einheitlicher Stand im Team',
    text: 'Das ganze Team arbeitet mit KI, nicht nur die Early Adopter. Mit abgestimmten Tools und gemeinsamen Spielregeln.',
  },
  {
    title: 'Schnellere Ergebnisse',
    text: 'Code Reviews in Minuten statt Stunden. Tests, die sich selbst schreiben. Dokumentation, die nicht liegen bleibt.',
  },
  {
    title: 'Ein Fahrplan über den Workshop hinaus',
    text: 'Welche Tools, welche Workflows, welche nächsten Schritte. Und was Sie nicht brauchen.',
  },
];

const touchpoints = [
  {
    title: 'Features entwickeln',
    text: 'Vom Ticket in Jira oder Linear bis durch Ihre CI/CD-Pipeline. Ohne dass Ihr Team die Kontrolle abgibt.',
  },
  {
    title: 'Bugs fixen',
    text: 'Fehler eingrenzen, Ursache verstehen, Lösung vorschlagen lassen. Und wissen, wann man ihr traut.',
  },
  {
    title: 'Code Reviews beschleunigen',
    text: 'Reviews, die echte Probleme finden, nicht nur Formatierung. Und wie Ihr Team bei mehr Pull Requests nicht im Review-Stapel untergeht.',
  },
  {
    title: 'Erst an Beispielen, dann an Ihrem Code',
    text: 'Erst klare Szenarien, bis das Konzept sitzt. Dann konkrete Fälle aus Ihrem Code.',
  },
];

const audience = [
  'Sie wissen, dass KI-Tools produktiver machen, aber die konkrete Umsetzung hakt',
  'Sie schon Vorreiter:innen im Team haben und der Rest nachziehen soll',
  'Ihre Entwickler:innen am eigenen Code lernen sollen, nicht an trockenen Beispielen',
  'Sie einen Plan wollen, nicht nur eine Inspiration',
];

const steps = [
  {
    title: 'Erstgespräch (kostenlos)',
    text: '30 Minuten, per Video oder Telefon. Wir lernen Ihr Team kennen und sagen Ihnen ehrlich, ob ein Workshop sinnvoll ist.',
  },
  {
    title: 'Workshop, vor Ort oder remote',
    text: 'Hands-on an Ihrem Code, passend zu Stack, Tooling und Erfahrung. Auch die Skeptiker:innen kommen mit.',
  },
  {
    title: 'Begleitung danach',
    text: 'Nach einem Vor-Ort-Workshop bleiben wir ansprechbar, für nächste Schritte, Fragen und die Umsetzung.',
  },
];

const team = [
  {
    name: 'Tobias Weber',
    image: 'images/tobias-weber.jpg',
    linkedin: 'https://www.linkedin.com/in/tobias-weber-589197134/',
    role: 'Senior Freelance Full-Stack Developer & IT-Consultant',
    experience: '8+ Jahre professioneller Full-Stack-Entwickler',
    companies: ['KURZ Digital Solutions (Fürth)', 'TSET (Wien)', 'msg for banking ag (München, Ismaning)', 'SOTA (London)'],
    extra: { text: 'KI-Schulungen für Teams' },
  },
  {
    name: 'Christian Braun',
    image: 'images/christian-braun.webp',
    linkedin: 'https://www.linkedin.com/in/hey-christian-braun/',
    role: 'Senior Freelance iOS Developer & IT-Consultant',
    experience: '8+ Jahre professioneller iOS-Developer',
    companies: ['adorsys (Nürnberg)', 'KURZ Digital Solutions (Fürth)', 'IBM (Hamburg, Berlin)'],
    extra: {
      text: ', ein Podcast über Technologie und KI im Entwicklungsalltag',
      link: { href: 'https://open.spotify.com/show/2r1FGvYRkSYq4SmXyVKmnA', label: 'Index out of bounds', prefix: 'Host von ' },
    },
  },
];

const fieldClass = 'h-12 w-full rounded-[10px] border border-heading/50 bg-card px-4 text-heading placeholder:text-muted transition-colors duration-150 focus:border-accent';
const linkClass = 'text-accent underline underline-offset-2 transition-colors duration-150 hover:text-accent-hover';
const h2Class = 'text-balance text-[32px] font-medium leading-[1.12] tracking-[-0.02em] text-heading md:text-[40px]';
---

<Layout title="Braun & Weber - KI-Workshops für Entwicklungsteams" description="KI-Workshops für Entwicklungsteams: Coding Agents strukturiert im ganzen Team einführen, hands-on an Ihrem Code. Ab 1.500 € zzgl. MwSt. Kostenloses Erstgespräch.">

  <SiteNav sections />

  <main>
    <!-- Hero -->
    <section class="page grid min-h-[100svh] items-center gap-12 pb-16 pt-28 lg:grid-cols-[1.15fr_1fr] lg:gap-16 lg:pt-24">
      <div>
        <p class="rise font-mono text-[13px] text-muted">KI-Workshops für Entwicklungsteams</p>
        <h1 class="rise mt-4 text-balance text-[40px] font-medium leading-[1.06] tracking-[-0.02em] text-heading sm:text-[52px] lg:text-[56px] lg:leading-[1.04] lg:tracking-[-0.03em]" style="animation-delay: 40ms">
          Aus Einzelversuchen mit KI wird <span class="text-accent">ein Workflow fürs ganze Team</span>
        </h1>
        <p class="rise mt-6 max-w-[34rem] text-lg leading-[30px]" style="animation-delay: 80ms">
          Ein Hands-on-Workshop an Ihrem Code, für Vorreiter:innen und Skeptiker:innen. Ein Mensch behält dabei immer das letzte Wort.
        </p>
        <div class="rise mt-10 flex flex-wrap items-center gap-x-6 gap-y-4" style="animation-delay: 120ms">
          <a href="#kontakt" class="inline-flex h-12 items-center rounded-[10px] bg-ink px-5 font-medium text-on-ink transition-[background-color,transform] duration-150 hover:bg-ink-hover active:scale-[0.98]">Kostenloses Erstgespräch</a>
          <a href="#workshop" class="inline-flex h-12 items-center font-medium text-heading underline-offset-4 hover:underline">So läuft der Workshop</a>
        </div>
      </div>
      <div class="rise" style="animation-delay: 120ms">
        <AgentSession />
      </div>
    </section>

    <!-- Das Problem -->
    <section class="page grid gap-12 py-20 md:py-24 lg:grid-cols-[5fr_7fr] lg:gap-16">
      <div>
        <h2 class={h2Class}>Das kennen Sie: KI im Team, irgendwo zwischen Hype und Stillstand</h2>
        <p class="mt-6 text-lg leading-8">
          Zwei schwören auf Copilot, eine hat Coding Agents entdeckt, der Rest wartet ab. Oder es nutzt noch kaum jemand KI. Es fehlen nicht die Tools, sondern ein strukturierter Einstieg.
        </p>
      </div>
      <div class="lg:pt-2">
        <p class="font-mono text-[13px] text-muted">Was sich nach dem Workshop ändert</p>
        <ul class="mt-4 divide-y divide-divider border-y border-divider" data-reveal-group>
          {outcomes.map((item, index) => (
            <li class="grid grid-cols-[24px_1fr] gap-x-3 py-6" data-reveal style={`--i: ${index * 2}`}>
              <span class="font-mono text-lg leading-7 text-muted" aria-hidden="true">+</span>
              <div>
                <h3 class="text-lg font-medium leading-7 text-heading">{item.title}</h3>
                <p class="mt-2 leading-7">{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Wie der Workshop funktioniert -->
    <section id="workshop" class="page py-20 md:py-24">
      <h2 class={`${h2Class} max-w-3xl`}>Erst verstehen, dann anwenden. An Ihrem Code.</h2>
      <p class="mt-6 max-w-3xl text-lg leading-8">
        Erst das Konzept: Was sind Coding Agents, welche Tools gibt es, von Cursor über Claude Code bis Codex, und welches passt zu Ihrem Stack? Dann wird's konkret.
      </p>

      <div class="mt-16 grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <ol class="divide-y divide-divider border-y border-divider">
          {touchpoints.map((item, index) => (
            <li class="grid grid-cols-[32px_1fr] gap-x-3 py-6">
              <span class="font-mono text-[13px] leading-7 tabular-nums text-muted">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-lg font-medium leading-7 text-heading">{item.title}</h3>
                <p class="mt-1 leading-7">{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <ReviewCheck />
      </div>

      <div class="mt-16 grid items-start gap-6 lg:grid-cols-[7fr_5fr]">
        <div class="rounded-2xl border border-divider bg-card p-6 md:p-8">
          <h3 class="text-lg font-medium text-heading">Der Inhalt richtet sich nach Ihrem Team</h3>
          <p class="mt-3 leading-7">
            Steht Ihr Team am Anfang, starten wir bei den Grundlagen. Hat es schon Erfahrung, gehen wir in die Tiefe: vom Ticket bis zur Freigabe durch einen Menschen.
          </p>
        </div>
        <div class="rounded-2xl bg-raised p-6 md:p-8">
          <h3 class="text-lg font-medium text-heading">Wo landet Ihr Code?</h3>
          <p class="mt-3 leading-7">
            Viele starke Modelle laufen heute in den USA. Manche Anbieter bieten EU-Regionen oder DSGVO-konforme Verträge, mit unterschiedlichen Einschränkungen. Wir zeigen Ihnen die Optionen. Die Entscheidung treffen Sie mit Ihrem Datenschutz, nicht wir.
          </p>
        </div>
      </div>
    </section>

    <!-- Für wen -->
    <section id="fuer-wen" class="page py-20 md:py-24">
      <h2 class={h2Class}>Sie sind hier richtig, wenn …</h2>
      <div class="mt-10 grid items-start gap-12 lg:grid-cols-[7fr_5fr] lg:gap-16">
        <ul class="divide-y divide-divider border-y border-divider">
          {audience.map((line) => (
            <li class="grid grid-cols-[24px_1fr] gap-x-3 py-5 text-lg leading-8">
              <span class="font-mono text-muted" aria-hidden="true">+</span>
              <span>{line}</span>
            </li>
          ))}
        </ul>
        <aside class="rounded-2xl bg-raised p-6 md:p-8">
          <h3 class="text-lg font-medium text-heading">Kein Entwicklungsteam, aber trotzdem neugierig?</h3>
          <p class="mt-3 leading-7">
            KI hilft auch in Vertrieb, Marketing und Sachbearbeitung. <a href="#kontakt" class="text-accent-hover underline underline-offset-2 transition-colors duration-150 hover:text-heading">Schreiben Sie uns</a>, wir sagen Ihnen ehrlich, ob wir helfen können.
          </p>
        </aside>
      </div>
    </section>

    <!-- Ablauf -->
    <section id="ablauf" class="page py-20 md:py-24">
      <h2 class={h2Class}>Drei Schritte. Kein Drumherum.</h2>
      <div class="timeline relative mt-12" data-reveal-group>
        <span class="absolute inset-x-0 top-0 hidden h-px bg-divider md:block" aria-hidden="true"></span>
        <span class="timeline-line absolute inset-x-0 top-0 hidden h-0.5 origin-left bg-accent md:block" aria-hidden="true"></span>
        <ol class="grid gap-x-12 md:grid-cols-3">
          {steps.map((step, index) => (
            <li class="border-t border-divider py-8 md:border-t-0" data-reveal style={`--i: ${index * 3 + 1}`}>
              <span class="font-mono text-[13px] tabular-nums text-accent">{String(index + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-lg font-medium text-heading">{step.title}</h3>
              <p class="mt-2 leading-7">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Preise -->
    <section id="preise" class="page py-20 md:py-24">
      <h2 class={h2Class}>Was es kostet</h2>
      <p class="mt-6 max-w-2xl text-lg leading-8">
        Jedes Format stimmen wir vorher im Erstgespräch auf Ihr Team ab.
      </p>

      <div class="mt-12 grid divide-y divide-divider overflow-hidden rounded-2xl border border-divider bg-card md:grid-cols-3 md:divide-x md:divide-y-0">
        {formats.map((format) => (
          <div class="flex flex-col p-6 md:p-8">
            <h3 class="font-mono text-[13px] text-muted"><span class="text-heading">{format.mode}</span> · {format.duration}</h3>
            <p class="mt-4 text-[32px] font-medium leading-none tracking-[-0.01em] tabular-nums text-heading">{formatEuro(format.price)}</p>
            <ul class="mt-8 grid gap-3 leading-6">
              {format.items.map((item) => (
                <li class={`grid grid-cols-[20px_1fr] gap-x-2 ${item.included ? '' : 'text-muted'}`}>
                  <span class={`font-mono ${item.included ? 'text-heading' : 'text-muted'}`} aria-hidden="true">{item.included ? '+' : '−'}</span>
                  <span>{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <div class="mt-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
        <p class="text-sm text-muted">Bis {MAX_PARTICIPANTS} Teilnehmende, größere Teams auf Anfrage. Alle Preise zzgl. MwSt.</p>
        <a href="#kontakt" class="text-sm font-medium text-heading underline-offset-4 hover:underline">Passendes Format im Erstgespräch klären</a>
      </div>
    </section>

    <!-- Wer wir sind -->
    <section id="ueber-uns" class="page py-20 md:py-24">
      <h2 class={`${h2Class} max-w-3xl`}>Zwei Entwickler, die jeden Tag mit KI-Tools arbeiten</h2>
      <p class="mt-6 max-w-3xl text-lg leading-8">
        Keine Unternehmensberater, die KI aus der Ferne erklären. Wir schreiben selbst jeden Tag Code mit Coding Agents und wissen, was funktioniert und wo man aufpassen muss.
      </p>

      <div class="mt-16 grid gap-x-16 gap-y-12 md:grid-cols-2">
        {team.map((person) => (
          <article class="border-t border-divider pt-8">
            <div class="flex items-center gap-5">
              <img src={`${base}${person.image}`} alt={person.name} width="80" height="80" loading="lazy" class="size-20 shrink-0 rounded-full object-cover" />
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl font-medium text-heading">{person.name}</h3>
                  <a href={person.linkedin} target="_blank" rel="noopener" class="text-muted transition-colors duration-150 hover:text-heading" aria-label={`${person.name} auf LinkedIn`}><LinkedInIcon class="size-4" /></a>
                </div>
                <p class="mt-1 text-sm text-body">{person.role}</p>
              </div>
            </div>
            <ul class="mt-6 grid gap-3 leading-7">
              <li class="grid grid-cols-[20px_1fr] gap-x-2">
                <span class="font-mono text-muted" aria-hidden="true">+</span>
                <span>
                  {person.experience}
                  <span class="mt-1 block font-mono text-[13px] leading-6 text-muted">{person.companies.join(' · ')}</span>
                </span>
              </li>
              <li class="grid grid-cols-[20px_1fr] gap-x-2">
                <span class="font-mono text-muted" aria-hidden="true">+</span>
                <span>
                  {person.extra.link ? (
                    <>{person.extra.link.prefix}<a href={person.extra.link.href} target="_blank" rel="noopener" class={linkClass}>{person.extra.link.label}</a>{person.extra.text}</>
                  ) : person.extra.text}
                </span>
              </li>
              <li class="grid grid-cols-[20px_1fr] gap-x-2">
                <span class="font-mono text-muted" aria-hidden="true">+</span>
                <span>Co-Founder <a href="https://picaboo-app.com" target="_blank" rel="noopener" class={linkClass}>PICABOO</a></span>
              </li>
            </ul>
          </article>
        ))}
      </div>

      <figure class="mt-20 max-w-3xl">
        <span class="block h-0.5 w-8 bg-accent" aria-hidden="true"></span>
        <blockquote class="mt-6 text-xl leading-9 text-heading md:text-2xl md:leading-10">
          Wir kennen uns seit Jahren, beruflich und privat. KI in der Softwareentwicklung ist das Thema, über das wir abends beim Bier reden. Wir sind überzeugt, dass jedes Entwicklungsteam davon profitieren kann, und es macht uns Spaß, dieses Wissen weiterzugeben.
        </blockquote>
        <figcaption class="mt-4 text-sm text-muted">Christian &amp; Tobias</figcaption>
      </figure>
    </section>

    <!-- Kontakt -->
    <section id="kontakt" class="page grid gap-12 py-20 md:py-24 lg:grid-cols-[5fr_7fr] lg:gap-16">
      <div>
        <h2 class={h2Class}>Erstgespräch vereinbaren. Kostenlos, 30 Minuten.</h2>
        <p class="mt-6 text-lg leading-8">
          Kein Verkaufsgespräch. Wir hören zu und sagen Ihnen ehrlich, ob ein Workshop für Ihr Team sinnvoll ist. Antwort innerhalb von 24 Stunden.
        </p>
        <a href="tel:+4915256719943" class="mt-8 inline-flex h-12 items-center gap-3 rounded-[10px] border border-divider px-5 font-medium text-heading transition-colors duration-150 hover:bg-raised">
          <svg class="size-[18px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>Oder rufen Sie an: <span class="tabular-nums">0152 567 199 43</span></span>
        </a>
      </div>

      <form id="contact-form" class="grid gap-5 rounded-2xl border border-divider bg-card p-6 md:p-8">
        <div>
          <label for="email" class="mb-2 block text-sm font-medium text-heading">E-Mail-Adresse *</label>
          <input type="email" id="email" name="email" required autocomplete="email" class={fieldClass} placeholder="ihre@email.de" />
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="company" class="mb-2 block text-sm font-medium text-heading">Unternehmen</label>
            <input type="text" id="company" name="company" autocomplete="organization" class={fieldClass} placeholder="Firmenname" />
          </div>
          <div>
            <label for="teamsize" class="mb-2 block text-sm font-medium text-heading">Teamgröße (Entwickler:innen)</label>
            <input type="text" id="teamsize" name="teamsize" class={fieldClass} placeholder="z. B. 8 Personen" />
          </div>
        </div>
        <div>
          <label for="message" class="mb-2 block text-sm font-medium text-heading">Nachricht</label>
          <textarea id="message" name="message" rows="4" class={`${fieldClass} h-auto resize-none py-3`} placeholder="Welcher Stack, welche Tools nutzt Ihr Team schon, wo hakt es?"></textarea>
        </div>
        <button type="submit" class="min-h-12 w-full cursor-pointer rounded-[10px] px-4 py-3 bg-ink font-medium text-on-ink transition-[background-color,transform] duration-150 hover:bg-ink-hover active:scale-[0.98]">
          Kostenloses Erstgespräch vereinbaren
        </button>
      </form>
    </section>
  </main>

  <PromptEasterEgg />

  <SiteFooter />

  <script>
    document.getElementById('contact-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const value = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value;
      const email = value('email');
      const company = value('company');
      const teamsize = value('teamsize');
      const message = value('message');

      const lines = [];
      if (company) lines.push('Unternehmen: ' + company);
      if (email) lines.push('E-Mail: ' + email);
      if (teamsize) lines.push('Teamgröße: ' + teamsize);
      if (message) lines.push('\n' + message);

      const body = encodeURIComponent(lines.join('\n'));
      const subject = encodeURIComponent('KI-Workshop – Erstgespräch' + (company ? ' (' + company + ')' : ''));
      const to = 'hello@tobi-weber.com,christian.braun@theempathicdev.de';

      window.location.href = 'mailto:' + to + '?subject=' + subject + '&body=' + body;
    });
  </script>

</Layout>
